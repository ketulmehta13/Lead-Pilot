# Copy to .env and fill in. Never commit .env.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# --- Postgres (used by docker compose to build DATABASE_URL) ---
POSTGRES_DB=leadpilot
POSTGRES_USER=leadpilot
POSTGRES_PASSWORD=leadpilot
# For running the backend outside Docker against the compose Postgres, uncomment:
# DATABASE_URL=postgres://leadpilot:leadpilot@localhost:5432/leadpilot
# REDIS_URL=redis://localhost:6379/0

# --- GenAI (Phase 4+) ---
LLM_PROVIDER=groq
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
ANTHROPIC_API_KEY=

# --- Razorpay, TEST MODE ONLY (Phase 7) ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
