# Copy to .env and fill in. Never commit .env.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
FRONTEND_URL=http://localhost:5173
# Console backend prints emails (task reminders) to the celery log; use SMTP in production.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=LeadPilot <no-reply@leadpilot.local>

# --- Postgres (used by docker compose to build DATABASE_URL) ---
POSTGRES_DB=leadpilot
POSTGRES_USER=leadpilot
POSTGRES_PASSWORD=leadpilot
# For running the backend outside Docker against the compose Postgres, uncomment:
# DATABASE_URL=postgres://leadpilot:leadpilot@localhost:5432/leadpilot
# REDIS_URL=redis://localhost:6379/0

# --- GenAI (Phase 4+) ---
# Provider: groq | anthropic | openai | mock. Empty = groq if GROQ_API_KEY is set, else
# anthropic if ANTHROPIC_API_KEY is set, else offline "mock" placeholders.
LLM_PROVIDER=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Empty = provider default (groq: llama-3.3-70b-versatile, anthropic: claude-opus-5-5)
LLM_MODEL=
# Claude only: low | medium | high | xhigh | max
LLM_EFFORT=low
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
GENAI_RATE_LIMIT=20/min

# --- RAG / Ask LeadPilot (Phase 5) ---
# sentence-transformers (all-MiniLM-L6-v2, downloaded once ~90 MB) or hash (offline, tests)
EMBEDDINGS_BACKEND=sentence-transformers
# Below this cosine similarity the answer is "I don't know" (halved when the question names a
# company/contact or a date range, which already pins the right records).
RAG_MIN_SIMILARITY=0.35

# --- Razorpay, TEST MODE ONLY (Phase 7) ---
# Dashboard (Test Mode) -> Settings -> API Keys. Webhook secret: Settings -> Webhooks.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
